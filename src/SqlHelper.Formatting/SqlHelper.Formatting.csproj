<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so the same assembly loads in the .NET Framework VSIX host and in modern .NET (CLI, VS Code) -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SqlHelper.Formatting</RootNamespace>
    <Description>T-SQL formatter for SQL Helper, built on Microsoft's ScriptDom parser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlHelper.Formatting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rewrites\BracketedNames.txt" LogicalName="SqlHelper.Formatting.BracketedNames.txt" />
  </ItemGroup>

</Project>
