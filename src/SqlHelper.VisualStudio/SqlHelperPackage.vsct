<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidSqlHelperPackage">
    <Menus>
      <!-- A top-level SQL Helper menu; VS 2019+ (and so SSMS 22) moves extension menus under Extensions. -->
      <Menu guid="guidSqlHelperCmdSet" id="SqlHelperMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>SQL Helper</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" priority="0x0100">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenu" />
      </Group>
      <!-- Right-click menu in the code editor; placed in SSMS's query editor below. Holds the SQL Helper submenu. -->
      <Group guid="guidSqlHelperCmdSet" id="EditorContextMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSqlHelperCmdSet" id="FormatSqlCommand" priority="0x0100" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="FormatDocument" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Format SQL</ButtonText>
          <CanonicalName>SqlHelper.FormatSql</CanonicalName>
          <LocCanonicalName>SqlHelper.FormatSql</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="CleanAndFormatCommand" priority="0x0110" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="FormatSelection" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Clean and Format</ButtonText>
          <CanonicalName>SqlHelper.CleanAndFormat</CanonicalName>
          <LocCanonicalName>SqlHelper.CleanAndFormat</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="CleanupCommand" priority="0x0150" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="CleanData" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Clean Up</ButtonText>
          <CanonicalName>SqlHelper.CleanUp</CanonicalName>
          <LocCanonicalName>SqlHelper.CleanUp</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="HeaderCommand" priority="0x0200" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="AddComment" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Add Header</ButtonText>
          <CanonicalName>SqlHelper.AddHeader</CanonicalName>
          <LocCanonicalName>SqlHelper.AddHeader</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="SemicolonsCommand" priority="0x0300" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Add" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Add Semicolons</ButtonText>
          <CanonicalName>SqlHelper.AddSemicolons</CanonicalName>
          <LocCanonicalName>SqlHelper.AddSemicolons</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="MarkersCommand" priority="0x0400" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Bookmark" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Add Server-Side Markers</ButtonText>
          <CanonicalName>SqlHelper.AddServerSideMarkers</CanonicalName>
          <LocCanonicalName>SqlHelper.AddServerSideMarkers</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="ToDynamicCommand" priority="0x0500" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="DynamicProcedure" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Convert to Dynamic SQL</ButtonText>
          <CanonicalName>SqlHelper.ConvertToDynamicSql</CanonicalName>
          <LocCanonicalName>SqlHelper.ConvertToDynamicSql</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlHelperCmdSet" id="FromDynamicCommand" priority="0x0510" type="Button">
        <Parent guid="guidSqlHelperCmdSet" id="SqlHelperMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="DatabaseScript" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Convert from Dynamic SQL</ButtonText>
          <CanonicalName>SqlHelper.ConvertFromDynamicSql</CanonicalName>
          <LocCanonicalName>SqlHelper.ConvertFromDynamicSql</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- The same SQL Helper menu again as a right-click submenu, so new commands only need adding to it once. -->
    <CommandPlacement guid="guidSqlHelperCmdSet" id="SqlHelperMenu" priority="0x0100">
      <Parent guid="guidSqlHelperCmdSet" id="EditorContextMenuGroup" />
    </CommandPlacement>
    <!-- SSMS's query editor has its own right-click menu rather than the code editor's. -->
    <CommandPlacement guid="guidSqlHelperCmdSet" id="EditorContextMenuGroup" priority="0x0600">
      <Parent guid="guidSqlEditorContextMenu" id="SqlEditorContextMenu" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <!-- Ctrl+Alt+F in the text editor, as in the old extension. Reassign under Tools > Options > Keyboard. -->
    <KeyBinding guid="guidSqlHelperCmdSet" id="FormatSqlCommand" editor="guidTextEditor" mod1="Control Alt" key1="F" />
    <KeyBinding guid="guidSqlHelperCmdSet" id="HeaderCommand" editor="guidTextEditor" mod1="Control Alt" key1="H" />
    <KeyBinding guid="guidSqlHelperCmdSet" id="CleanAndFormatCommand" editor="guidTextEditor" mod1="Control Alt" key1="C" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSqlHelperPackage" value="{d476471b-7c48-48a7-8be0-451c4290ae08}" />
    <GuidSymbol name="guidTextEditor" value="{8b382828-6202-11d1-8870-0000f87579d2}" />
    <!-- SSMS's query editor right-click menu, as SSMS 22's own formatter extension places itself (id 80 decimal). -->
    <GuidSymbol name="guidSqlEditorContextMenu" value="{33f13ac3-80bb-4ecb-85bc-225435603a5e}">
      <IDSymbol name="SqlEditorContextMenu" value="0x0050" />
    </GuidSymbol>
    <GuidSymbol name="guidSqlHelperCmdSet" value="{2de80807-30c5-4fd7-81ef-a3cd5102261d}">
      <IDSymbol name="SqlHelperMenu" value="0x1001" />
      <IDSymbol name="SqlHelperMenuGroup" value="0x1002" />
      <IDSymbol name="EditorContextMenuGroup" value="0x1003" />
      <IDSymbol name="FormatSqlCommand" value="0x0100" />
      <IDSymbol name="HeaderCommand" value="0x0101" />
      <IDSymbol name="SemicolonsCommand" value="0x0102" />
      <IDSymbol name="MarkersCommand" value="0x0103" />
      <IDSymbol name="CleanupCommand" value="0x0104" />
      <IDSymbol name="ToDynamicCommand" value="0x0105" />
      <IDSymbol name="FromDynamicCommand" value="0x0106" />
      <IDSymbol name="CleanAndFormatCommand" value="0x0107" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
