<Project Sdk="Microsoft.NET.Sdk">

  <!-- VS 2026 / SSMS 22 extension. The build produces bin\<Configuration>\net48\SqlHelper.VisualStudio.vsix. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SqlHelper.VisualStudio</RootNamespace>
    <Description>SQL Helper for Visual Studio and SQL Server Management Studio.</Description>

    <!-- Pulls in the VSIX build targets from the Microsoft.VSSDK.BuildTools package. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <!-- Building shouldn't install anything; install the .vsix by hand, or debug in the experimental instance. -->
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlHelper.Formatting\SqlHelper.Formatting.csproj" />
    <Reference Include="System.Design" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="SqlHelperPackage.vsct" ResourceName="Menus.ctmenu" />
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="registration.json" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The version (see Directory.Build.props) for the manifest's |%CurrentProject%;GetVsixVersion| token. -->
  <Target Name="GetVsixVersion" DependsOnTargets="SetVersionFromGit" Returns="$(Version)" />

  <!-- The same version as a constant, for [InstalledProductRegistration] (Help > About). -->
  <Target Name="GenerateBuildVersion" BeforeTargets="CoreCompile" DependsOnTargets="SetVersionFromGit">
    <PropertyGroup>
      <_BuildVersionFile>$(IntermediateOutputPath)BuildVersion.g.cs</_BuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace SqlHelper.VisualStudio { internal static class BuildVersion { public const string Value = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(_BuildVersionFile)" />
      <FileWrites Include="$(_BuildVersionFile)" />
    </ItemGroup>
  </Target>

  <!-- Keeps a private extension gallery at <repo>\gallery up to date, so Visual Studio can update from it (see README).
       Not on CI, where the release workflow writes its own feed. -->
  <Target Name="UpdateGallery" AfterTargets="CreateVsixContainer" Condition="'$(DesignTimeBuild)' != 'true' and '$(CI)' != 'true' and Exists('$(TargetVsixContainer)')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Update-Gallery.ps1&quot; -VsixPath &quot;$(TargetVsixContainer)&quot; -GalleryDirectory &quot;$(MSBuildThisFileDirectory)..\..\gallery&quot;" />
  </Target>

</Project>
